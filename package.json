{
  "name": "pietra-unica-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run db:backup:silent && next dev",
    "build": "next build",
    "start": "npm run db:backup:silent && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup:silent": "tsx scripts/backup.ts || true",
    "prisma:generate": "prisma generate",
    "worker": "tsx src/worker/index.ts",
    "poweroffice:types": "openapi-typescript docs/poweroffice-apiv2-demo.json -o src/integrations/poweroffice/schema.d.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "build:installer-tasks": "node scripts/build-installer-tasks.mjs",
    "build:desktop": "npm run build && npm run build:worker && npm run build:installer-tasks"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@react-pdf/renderer": "^4.9.0",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "next": "^14.2.35",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
