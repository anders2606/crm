# Database (kap. 15: PostgreSQL 16). I utvikling: docker-compose opp postgres.
DATABASE_URL="postgresql://pietra:pietra@localhost:5432/pietra_unica_crm"

# Signeringsnøkkel for det korte mellomsteget mellom passord og 2FA-kode
# (ikke selve sesjonen, som ligger i databasen). Generer f.eks. med:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Kun for utvikling – seed-bruker (arbeidsregel 5). Sett aldri ekte passord her.
SEED_ADMIN_EMAIL=admin@pietraunica.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Backup (DR-03/DR-06)
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=30
