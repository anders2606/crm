# Database (kap. 15: PostgreSQL 16). I utvikling: docker-compose opp postgres.
DATABASE_URL="postgresql://pietra:pietra@localhost:5432/pietra_unica_crm"

# Signeringsnøkkel for det korte mellomsteget mellom passord og 2FA-kode
# (ikke selve sesjonen, som ligger i databasen). Generer f.eks. med:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Kun for utvikling – seed-bruker (arbeidsregel 5). Sett aldri ekte passord her.
SEED_ADMIN_EMAIL=admin@pietraunica.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Backup (DR-03/DR-06)
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=30

# Dokumentlagring (DO-08) – lokal disk bak et lagringsgrensesnitt
STORAGE_DIR=./data/documents

# M3 – kryptering av e-postkontopassord i databasen. DR-08 fullføres med ekte
# nøkkelring i M9; fram til da er dette krypteringen som beskytter dem i basen.
# Generer f.eks. med: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# M3 – kun for utvikling: én egen testkonto hos e-postleverandøren
# (arbeidsregel 5). Sett ALDRI inn en ekte postboks her.
TEST_EMAIL_ADDRESS=
TEST_EMAIL_USERNAME=
TEST_EMAIL_PASSWORD=
TEST_EMAIL_IMAP_HOST=
TEST_EMAIL_IMAP_PORT=993
TEST_EMAIL_SMTP_HOST=
TEST_EMAIL_SMTP_PORT=465

# M3 – "real" kobler workeren til ekte IMAP/SMTP-servere. Stå tom/"mock" i
# vanlig utvikling og alltid i tester (src/integrations/mail).
MAIL_INTEGRATION_MODE=mock

# M4 – "real" kobler workeren til Norges Banks ekte valutakurs-API. Stå
# tom/"mock" i vanlig utvikling og alltid i tester (src/integrations/exchange-rates).
EXCHANGE_RATE_INTEGRATION_MODE=mock
