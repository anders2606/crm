// Prisma-skjema – M0 Fundament (GE-03, GE-04, GE-06, DR-01)
// Databaseendringer skjer kun via migreringer (`npm run db:migrate`), aldri manuelt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  roles         UserRole[]
  sessions      Session[]
  auditLogs     AuditLog[]     @relation("AuditLogUser")
  tasks         Task[]
  emailAccounts EmailAccount[] @relation("EmailAccountOwner")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  users              UserRole[]
  permissions        RolePermission[]
  emailAccountAccess EmailAccountRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // f.eks. "customer.read", "invoice.approve"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// GE-06: revisjonsspor for alle registreringer og endringer.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String // "create" | "update" | "delete" | "login" | "login_failed"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// M1 Kunder og leverandører (KU-01–06, KU-08 [kun datamodell], KU-11, KU-12,
// LE-01–05, LE-09, GE-07).
//
// ContactPerson/Address/Consent kobles til enten Customer ELLER Supplier
// (aldri begge) via to valgfrie fremmednøkler + en CHECK-constraint lagt til
// i migreringen. Activity/Task kobles til «hvilken som helst hovedentitet»
// (kap. 17) med samme entityType+entityId-mønster som AuditLog allerede
// bruker, siden de skal kunne peke på stadig flere entiteter etter hvert som
// systemet vokser (tilbud, ordre, prosjekt, ...).
// ---------------------------------------------------------------------------

model Customer {
  id                  String       @id @default(uuid())
  type                CustomerType
  name                String
  orgNr               String?
  email               String?
  phone               String?
  creditLimitCents    Int?
  creditLimitCurrency String       @default("NOK")
  paymentTermsDays    Int?
  poweroffice_id      String?      @unique
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  createdById         String?

  addresses      Address[]
  contactPersons ContactPerson[]
  consents       Consent[]
  groups         CustomerGroup[] @relation("CustomerToGroup")

  @@index([orgNr])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id                  String    @id @default(uuid())
  name                String
  country             String
  email               String?
  phone               String?
  website             String?
  currency            String    @default("EUR")
  incoterms           String?
  paymentTermsDays    Int?
  creditLimitCents    Int?
  creditLimitCurrency String    @default("EUR")
  iban                String?
  bic                 String?
  poweroffice_id      String?   @unique
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?

  addresses      Address[]
  contactPersons ContactPerson[]
  materials      MaterialSupplier[]
  priceEntries   PriceEntry[]

  @@index([name])
  @@map("suppliers")
}

model Address {
  id         String      @id @default(uuid())
  type       AddressType
  street     String
  postalCode String
  city       String
  region     String?
  country    String      @default("NO")
  customerId String?
  supplierId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([supplierId])
  @@map("addresses")
}

model ContactPerson {
  id          String   @id @default(uuid())
  name        String
  role        String?
  email       String?
  phone       String?
  language    String   @default("nb")
  customerId  String?
  supplierId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  consents Consent[]

  @@index([customerId])
  @@index([supplierId])
  @@map("contact_persons")
}

model CustomerGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  customers Customer[] @relation("CustomerToGroup")

  @@map("customer_groups")
}

// KU-11: samtykke til nyhetsbrev/markedsføring, med dato og kilde.
model Consent {
  id              String        @id @default(uuid())
  channel         String
  status          ConsentStatus
  occurredAt      DateTime      @default(now())
  source          String?
  customerId      String?
  contactPersonId String?
  createdAt       DateTime      @default(now())
  createdById     String?

  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactPerson ContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("consents")
}

// KU-06/LE-09: tidslinje. E-post (EP-*) og statusendringer på tilbud/ordre
// kobles inn automatisk fra M3/M5 – her registreres kun manuelle typer i M1.
model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  text        String
  occurredAt  DateTime     @default(now())
  entityType  String
  entityId    String
  createdAt   DateTime     @default(now())
  createdById String?

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("activities")
}

// GE-07: oppgaver og påminnelser per bruker.
model Task {
  id          String     @id @default(uuid())
  title       String
  dueAt       DateTime?
  status      TaskStatus @default(OPEN)
  assigneeId  String
  entityType  String?
  entityId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?

  assignee User @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status])
  @@index([entityType, entityId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// M2 Dokumenter (DO-01–05, DO-08). Kobles til «hvilken som helst hovedentitet»
// (kap. 17: Customer/Supplier/Project/Quote/Order/Material/EmailMessage) med
// samme entityType+entityId-mønster som Activity/Task, siden de fleste av
// disse entitetene ikke finnes før senere milepæler.
//
// Versjonering (DO-04): alle versjoner av «samme» dokument deler `groupId`
// (lik `id` for første versjon). Ny versjon setter forrige `isCurrent=false`,
// men den forblir tilgjengelig (aldri slettet).
// ---------------------------------------------------------------------------
model Document {
  id          String           @id @default(uuid())
  groupId     String
  version     Int              @default(1)
  isCurrent   Boolean          @default(true)
  fileName    String
  mimeType    String
  sizeBytes   Int
  category    DocumentCategory
  storageKey  String
  ocrText     String? // DO-06 (BØR) – fylles inn når OCR-indeksering bygges
  entityType  String
  entityId    String
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?

  @@index([entityType, entityId])
  @@index([groupId])
  @@map("documents")
}

enum DocumentCategory {
  DRAWING
  PHOTO
  QUOTE_SENT
  QUOTE_RECEIVED
  ORDER_CONFIRMATION
  INVOICE
  CONTRACT
  OTHER
}

// ---------------------------------------------------------------------------
// M3 E-post (EP-01–07). Passordet er kryptert (src/lib/secrets.ts, AES-256-GCM)
// med ENCRYPTION_KEY – ekte macOS-nøkkelring (DR-08) kommer i M9.
//
// EmailMessage er unik per (emailAccountId, folder, uid) – matcher hvordan
// IMAP-UID-er brukes til å unngå duplikater ved resynkronisering (kap. 18).
// Vedlegg lagres som Document med entityType="EmailMessage" inntil meldingen
// er koblet til en kunde/leverandør, og «re-foreldres» da (EP-04/EP-05).
// ---------------------------------------------------------------------------

model EmailAccount {
  id                String   @id @default(uuid())
  address           String   @unique
  username          String
  encryptedPassword String
  imapHost          String
  imapPort          Int      @default(993)
  smtpHost          String
  smtpPort          Int      @default(465)
  shared            Boolean  @default(false)
  ownerUserId       String?
  syncFromDate      DateTime @default(now())
  // Siste synkede IMAP-UID per mappe, f.eks. {"INBOX": 123, "Sent": 45} (kap. 18).
  lastSeenUid       Json     @default("{}")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  owner       User?              @relation("EmailAccountOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  accessRoles EmailAccountRole[]
  messages    EmailMessage[]

  @@map("email_accounts")
}

// EP-03: administrator styrer hvilke roller som har tilgang til hver felles postboks.
model EmailAccountRole {
  emailAccountId String
  roleId         String

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([emailAccountId, roleId])
  @@map("email_account_roles")
}

model EmailMessage {
  id             String         @id @default(uuid())
  emailAccountId String
  folder         String
  uid            Int
  messageId      String?
  inReplyTo      String?
  direction      EmailDirection
  fromAddress    String
  fromName       String?
  toAddresses    String[]
  ccAddresses    String[]
  subject        String?
  textBody       String?
  occurredAt     DateTime
  entityType     String?
  entityId       String?
  handledById    String?
  createdAt      DateTime       @default(now())

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, folder, uid])
  @@index([entityType, entityId])
  @@index([messageId])
  @@index([fromAddress])
  @@map("email_messages")
}

enum EmailDirection {
  IN
  OUT
}

enum CustomerType {
  COMPANY
  PRIVATE
}

enum AddressType {
  VISIT
  INVOICE
  DELIVERY
}

enum ConsentStatus {
  GIVEN
  WITHDRAWN
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  STATUS
  EMAIL
}

enum TaskStatus {
  OPEN
  DONE
}

// ---------------------------------------------------------------------------
// M4 Materialbibliotek (MA-01–04, MA-06, MA-08). Bilder (MA-02) gjenbruker
// Document fra M2 (entityType="Material", kategori PHOTO) – ingen ny
// lagringskode. Valutakurser hentes av workeren fra Norges Bank (kap. 18),
// aldri direkte i en brukerforespørsel (arbeidsregel 12).
// ---------------------------------------------------------------------------

model Material {
  id               String                @id @default(uuid())
  name             String
  tradeName        String?
  type             MaterialType
  origin           String?
  color            String?
  finish           MaterialFinish?
  thicknessesMm    Int[]
  slabSizes        String[]
  maintenanceNotes String?
  availability     MaterialAvailability  @default(AVAILABLE)
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  createdById      String?

  suppliers    MaterialSupplier[]
  priceEntries PriceEntry[]

  @@index([type])
  @@index([name])
  @@map("materials")
}

enum MaterialType {
  MARBLE
  GRANITE
  QUARTZITE
  COMPOSITE
  OTHER
}

enum MaterialFinish {
  POLISHED
  HONED
  BRUSHED
  OTHER
}

enum MaterialAvailability {
  AVAILABLE
  ON_ORDER
  DISCONTINUED
}

// MA-06: kobling til leverandør(er).
model MaterialSupplier {
  materialId String
  supplierId String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([materialId, supplierId])
  @@map("material_suppliers")
}

// MA-03/MA-04: historiske innkjøps-/utsalgspriser, i opprinnelig valuta og
// omregnet til NOK-øre med Norges Bank-kurs for prisdatoen.
model PriceEntry {
  id             String         @id @default(uuid())
  materialId     String
  type           PriceEntryType
  supplierId     String?
  amountMinor    Int
  currency       String
  amountNokMinor Int
  unit           String
  priceDate      DateTime       @db.Date
  source         String?
  createdAt      DateTime       @default(now())
  createdById    String?

  material Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([materialId, type, priceDate])
  @@map("price_entries")
}

enum PriceEntryType {
  PURCHASE
  SALE
}

// Daglige valutakurser fra Norges Bank, lagret lokalt (kap. 18). Kurs
// mangler for helg/helligdag: slå opp siste dato <= ønsket dato.
model ExchangeRate {
  id              String   @id @default(uuid())
  currency        String
  date            DateTime @db.Date
  microNokPerUnit Int
  createdAt       DateTime @default(now())

  @@unique([currency, date])
  @@index([currency, date])
  @@map("exchange_rates")
}
