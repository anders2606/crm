// Prisma-skjema – M0 Fundament (GE-03, GE-04, GE-06, DR-01)
// Databaseendringer skjer kun via migreringer (`npm run db:migrate`), aldri manuelt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  roles         UserRole[]
  sessions      Session[]
  auditLogs     AuditLog[]     @relation("AuditLogUser")
  tasks         Task[]
  emailAccounts EmailAccount[] @relation("EmailAccountOwner")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  users              UserRole[]
  permissions        RolePermission[]
  emailAccountAccess EmailAccountRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // f.eks. "customer.read", "invoice.approve"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// GE-06: revisjonsspor for alle registreringer og endringer.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String // "create" | "update" | "delete" | "login" | "login_failed"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// M1 Kunder og leverandører (KU-01–06, KU-08 [kun datamodell], KU-11, KU-12,
// LE-01–05, LE-09, GE-07).
//
// ContactPerson/Address/Consent kobles til enten Customer ELLER Supplier
// (aldri begge) via to valgfrie fremmednøkler + en CHECK-constraint lagt til
// i migreringen. Activity/Task kobles til «hvilken som helst hovedentitet»
// (kap. 17) med samme entityType+entityId-mønster som AuditLog allerede
// bruker, siden de skal kunne peke på stadig flere entiteter etter hvert som
// systemet vokser (tilbud, ordre, prosjekt, ...).
// ---------------------------------------------------------------------------

model Customer {
  id                      String       @id @default(uuid())
  type                    CustomerType
  name                    String
  orgNr                   String?
  email                   String?
  phone                   String?
  creditLimitCents        Int?
  creditLimitCurrency     String       @default("NOK")
  paymentTermsDays        Int?
  poweroffice_id          String?      @unique
  // IN-03/KU-03: cachet reskontrodata fra PowerOffice – kan ikke hentes live i
  // en sideforespørsel (arbeidsregel 12), så workeren oppdaterer dette minst
  // hver time (IN-22) og kundekortet leser fra cachen.
  outstandingBalanceMinor Int?
  overdueAmountMinor      Int?
  balanceSyncedAt         DateTime?
  deletedAt               DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  createdById             String?

  addresses      Address[]
  contactPersons ContactPerson[]
  consents       Consent[]
  groups         CustomerGroup[] @relation("CustomerToGroup")
  quotes         Quote[]
  followUpRule   FollowUpRule?

  @@index([orgNr])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id                  String    @id @default(uuid())
  name                String
  country             String
  email               String?
  phone               String?
  website             String?
  currency            String    @default("EUR")
  incoterms           String?
  paymentTermsDays    Int?
  creditLimitCents    Int?
  creditLimitCurrency String    @default("EUR")
  iban                String?
  bic                 String?
  poweroffice_id      String?   @unique
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?

  addresses      Address[]
  contactPersons ContactPerson[]
  materials      MaterialSupplier[]
  priceEntries   PriceEntry[]

  @@index([name])
  @@map("suppliers")
}

model Address {
  id         String      @id @default(uuid())
  type       AddressType
  street     String
  postalCode String
  city       String
  region     String?
  country    String      @default("NO")
  customerId String?
  supplierId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([supplierId])
  @@map("addresses")
}

model ContactPerson {
  id          String   @id @default(uuid())
  name        String
  role        String?
  email       String?
  phone       String?
  language    String   @default("nb")
  customerId  String?
  supplierId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  consents Consent[]

  @@index([customerId])
  @@index([supplierId])
  @@map("contact_persons")
}

model CustomerGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  customers     Customer[]     @relation("CustomerToGroup")
  templates     Template[]
  followUpRules FollowUpRule[]

  @@map("customer_groups")
}

// KU-11: samtykke til nyhetsbrev/markedsføring, med dato og kilde.
model Consent {
  id              String        @id @default(uuid())
  channel         String
  status          ConsentStatus
  occurredAt      DateTime      @default(now())
  source          String?
  customerId      String?
  contactPersonId String?
  createdAt       DateTime      @default(now())
  createdById     String?

  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactPerson ContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("consents")
}

// KU-06/LE-09: tidslinje. E-post (EP-*) og statusendringer på tilbud/ordre
// kobles inn automatisk fra M3/M5 – her registreres kun manuelle typer i M1.
model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  text        String
  occurredAt  DateTime     @default(now())
  entityType  String
  entityId    String
  createdAt   DateTime     @default(now())
  createdById String?

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("activities")
}

// GE-07: oppgaver og påminnelser per bruker.
model Task {
  id          String     @id @default(uuid())
  title       String
  dueAt       DateTime?
  status      TaskStatus @default(OPEN)
  assigneeId  String
  entityType  String?
  entityId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?

  assignee User @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status])
  @@index([entityType, entityId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// M2 Dokumenter (DO-01–05, DO-08). Kobles til «hvilken som helst hovedentitet»
// (kap. 17: Customer/Supplier/Project/Quote/Order/Material/EmailMessage) med
// samme entityType+entityId-mønster som Activity/Task, siden de fleste av
// disse entitetene ikke finnes før senere milepæler.
//
// Versjonering (DO-04): alle versjoner av «samme» dokument deler `groupId`
// (lik `id` for første versjon). Ny versjon setter forrige `isCurrent=false`,
// men den forblir tilgjengelig (aldri slettet).
// ---------------------------------------------------------------------------
model Document {
  id          String           @id @default(uuid())
  groupId     String
  version     Int              @default(1)
  isCurrent   Boolean          @default(true)
  fileName    String
  mimeType    String
  sizeBytes   Int
  category    DocumentCategory
  storageKey  String
  ocrText     String? // DO-06 (BØR) – fylles inn når OCR-indeksering bygges
  entityType  String
  entityId    String
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?

  @@index([entityType, entityId])
  @@index([groupId])
  @@map("documents")
}

enum DocumentCategory {
  DRAWING
  PHOTO
  QUOTE_SENT
  QUOTE_RECEIVED
  ORDER_CONFIRMATION
  INVOICE
  CONTRACT
  OTHER
}

// ---------------------------------------------------------------------------
// M3 E-post (EP-01–07). Passordet er kryptert (src/lib/secrets.ts, AES-256-GCM)
// med ENCRYPTION_KEY – ekte macOS-nøkkelring (DR-08) kommer i M9.
//
// EmailMessage er unik per (emailAccountId, folder, uid) – matcher hvordan
// IMAP-UID-er brukes til å unngå duplikater ved resynkronisering (kap. 18).
// Vedlegg lagres som Document med entityType="EmailMessage" inntil meldingen
// er koblet til en kunde/leverandør, og «re-foreldres» da (EP-04/EP-05).
// ---------------------------------------------------------------------------

model EmailAccount {
  id                String   @id @default(uuid())
  address           String   @unique
  username          String
  encryptedPassword String
  imapHost          String
  imapPort          Int      @default(993)
  smtpHost          String
  smtpPort          Int      @default(465)
  shared            Boolean  @default(false)
  ownerUserId       String?
  syncFromDate      DateTime @default(now())
  // Siste synkede IMAP-UID per mappe, f.eks. {"INBOX": 123, "Sent": 45} (kap. 18).
  lastSeenUid       Json     @default("{}")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  owner       User?              @relation("EmailAccountOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  accessRoles EmailAccountRole[]
  messages    EmailMessage[]

  @@map("email_accounts")
}

// EP-03: administrator styrer hvilke roller som har tilgang til hver felles postboks.
model EmailAccountRole {
  emailAccountId String
  roleId         String

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([emailAccountId, roleId])
  @@map("email_account_roles")
}

model EmailMessage {
  id             String         @id @default(uuid())
  emailAccountId String
  folder         String
  uid            Int
  messageId      String?
  inReplyTo      String?
  direction      EmailDirection
  fromAddress    String
  fromName       String?
  toAddresses    String[]
  ccAddresses    String[]
  subject        String?
  textBody       String?
  occurredAt     DateTime
  entityType     String?
  entityId       String?
  handledById    String?
  createdAt      DateTime       @default(now())

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, folder, uid])
  @@index([entityType, entityId])
  @@index([messageId])
  @@index([fromAddress])
  @@map("email_messages")
}

enum EmailDirection {
  IN
  OUT
}

enum CustomerType {
  COMPANY
  PRIVATE
}

enum AddressType {
  VISIT
  INVOICE
  DELIVERY
}

enum ConsentStatus {
  GIVEN
  WITHDRAWN
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  STATUS
  EMAIL
}

enum TaskStatus {
  OPEN
  DONE
}

// ---------------------------------------------------------------------------
// M4 Materialbibliotek (MA-01–04, MA-06, MA-08). Bilder (MA-02) gjenbruker
// Document fra M2 (entityType="Material", kategori PHOTO) – ingen ny
// lagringskode. Valutakurser hentes av workeren fra Norges Bank (kap. 18),
// aldri direkte i en brukerforespørsel (arbeidsregel 12).
// ---------------------------------------------------------------------------

model Material {
  id               String               @id @default(uuid())
  name             String
  tradeName        String?
  type             MaterialType
  origin           String?
  color            String?
  finish           MaterialFinish?
  thicknessesMm    Int[]
  slabSizes        String[]
  maintenanceNotes String?
  availability     MaterialAvailability @default(AVAILABLE)
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdById      String?

  suppliers    MaterialSupplier[]
  priceEntries PriceEntry[]
  quoteLines   QuoteLine[]

  @@index([type])
  @@index([name])
  @@map("materials")
}

enum MaterialType {
  MARBLE
  GRANITE
  QUARTZITE
  COMPOSITE
  OTHER
}

enum MaterialFinish {
  POLISHED
  HONED
  BRUSHED
  OTHER
}

enum MaterialAvailability {
  AVAILABLE
  ON_ORDER
  DISCONTINUED
}

// MA-06: kobling til leverandør(er).
model MaterialSupplier {
  materialId String
  supplierId String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([materialId, supplierId])
  @@map("material_suppliers")
}

// MA-03/MA-04: historiske innkjøps-/utsalgspriser, i opprinnelig valuta og
// omregnet til NOK-øre med Norges Bank-kurs for prisdatoen.
model PriceEntry {
  id             String         @id @default(uuid())
  materialId     String
  type           PriceEntryType
  supplierId     String?
  amountMinor    Int
  currency       String
  amountNokMinor Int
  unit           String
  priceDate      DateTime       @db.Date
  source         String?
  createdAt      DateTime       @default(now())
  createdById    String?

  material Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([materialId, type, priceDate])
  @@map("price_entries")
}

enum PriceEntryType {
  PURCHASE
  SALE
}

// Daglige valutakurser fra Norges Bank, lagret lokalt (kap. 18). Kurs
// mangler for helg/helligdag: slå opp siste dato <= ønsket dato.
model ExchangeRate {
  id              String   @id @default(uuid())
  currency        String
  date            DateTime @db.Date
  microNokPerUnit Int
  createdAt       DateTime @default(now())

  @@unique([currency, date])
  @@index([currency, date])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// M5 Tilbud og ordre (TO-01–10, TO-15, OP-01–08, SD-01–04).
//
// Template/TextBlock bruker samme groupId+version+isCurrent-mønster som
// Document (M2). Quote bruker et beslektet mønster for revisjoner (TO-10):
// alle revisjoner av «samme» tilbud deler `groupId` (lik `id` for revisjon 1)
// og `baseNumber`, mens `number` får synlig suffiks for revisjon > 1
// (T-10001, T-10001-2, ...) og `revision` styrer rekkefølgen.
//
// Løpende numre (TO-15) hentes fra ekte Postgres-sekvenser (quote_number_seq,
// order_number_seq), aldri fra en tellerkolonne, slik at numre aldri
// gjenbrukes selv ved samtidighet eller sletting (se migreringen for DDL).
//
// SD-04: `termsSnapshot` fryser vilkår/tekstblokk-innholdet slik det var da
// tilbudet ble sendt – en senere endring av malen påvirker aldri et sendt
// tilbud, kun tilbud som opprettes eller sendes etter endringen.
// ---------------------------------------------------------------------------

model Template {
  id              String         @id @default(uuid())
  groupId         String
  version         Int            @default(1)
  isCurrent       Boolean        @default(true)
  type            TemplateType
  name            String
  language        String         @default("nb")
  customerGroupId String?
  content         String
  status          TemplateStatus @default(DRAFT)
  comment         String? // SD-03: kommentar til denne versjonen
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?

  customerGroup    CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  quotesAsTemplate Quote[]        @relation("QuoteTemplate")
  followUpRules    FollowUpRule[]

  @@index([groupId])
  @@index([type, isCurrent])
  @@map("templates")
}

enum TemplateType {
  QUOTE
  ORDER_CONFIRMATION
  EMAIL
  FOLLOWUP
  NEWSLETTER
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

model TextBlock {
  id          String   @id @default(uuid())
  groupId     String
  version     Int      @default(1)
  isCurrent   Boolean  @default(true)
  name        String
  language    String   @default("nb")
  content     String
  comment     String? // SD-03
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([groupId])
  @@map("text_blocks")
}

model Quote {
  id                   String      @id @default(uuid())
  groupId              String
  baseNumber           Int
  revision             Int         @default(1)
  isCurrent            Boolean     @default(true)
  number               String      @unique
  status               QuoteStatus @default(DRAFT)
  customerId           String
  language             String      @default("nb")
  validUntil           DateTime?   @db.Date
  templateId           String?
  // TO-03: tekstblokker valgt inn i tilbudet (id-er, kun gjeldende versjoner
  // ved sending fryses inn i termsSnapshot – selve valget her kan endres
  // fritt fram til tilbudet sendes).
  selectedTextBlockIds String[]    @default([])
  // SD-04: frosset kopi av mal- og tekstblokkinnhold slik det var da tilbudet
  // ble sendt (HTML), ikke en referanse som følger senere malendringer.
  termsSnapshot        String?

  subtotalMinor Int    @default(0)
  discountMinor Int    @default(0)
  vatMinor      Int    @default(0)
  totalMinor    Int    @default(0)
  // Dekningsbidrag – kun internt, vises aldri til kunde (TO-05).
  dbMinor       Int    @default(0)
  currency      String @default("NOK")

  lostReason String?

  sentAt                DateTime?
  sentViaEmailAccountId String?
  respondedAt           DateTime?
  followUpsSent         Int       @default(0)
  nextFollowUpAt        DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  template     Template?     @relation("QuoteTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  lines        QuoteLine[]
  order        Order?
  followUpRule FollowUpRule?

  @@index([groupId])
  @@index([baseNumber])
  @@index([customerId])
  @@index([status])
  @@index([nextFollowUpAt])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  ANSWERED
  ACCEPTED
  REJECTED
  EXPIRED
}

// TO-04: linjer hentes fra materialbiblioteket eller skrives fritt.
// Antall lagres som tusendeler (`quantityMilli`) for å unngå flyttall ved
// f.eks. m²-mengder med desimaler (arbeidsregel 10).
model QuoteLine {
  id              String  @id @default(uuid())
  quoteId         String
  materialId      String?
  description     String
  quantityMilli   Int
  unit            String
  unitPriceMinor  Int
  discountPercent Int     @default(0)
  vatRatePercent  Int     @default(25)
  lineTotalMinor  Int
  sortOrder       Int     @default(0)

  quote    Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_lines")
}

// TO-08/TO-09: ordre opprettes fra et akseptert tilbud med ett klikk.
// `transferredToPowerOffice` er en tydelig markering av at overføring til
// PowerOffice ikke er bygget ennå (kommer i M6) – samme mønster som
// kundesynk i M1.
model Order {
  id                       String      @id @default(uuid())
  number                   String      @unique
  quoteId                  String      @unique
  status                   OrderStatus @default(CONFIRMED)
  advancePercent           Int?
  poweroffice_id           String?     @unique
  transferredToPowerOffice Boolean     @default(false)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  createdById              String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@map("orders")
}

enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  DELIVERED
  CANCELLED
}

// OP-02–06: oppfølgingsregler i prioritert rekkefølge tilbud > kunde >
// kundegruppe > standard. Nøyaktig én av customerGroupId/customerId/quoteId
// er satt avhengig av `scope` (CHECK-constraint i migreringen), untatt
// DEFAULT som ikke peker på noen.
model FollowUpRule {
  id              String        @id @default(uuid())
  scope           FollowUpScope
  customerGroupId String?       @unique
  customerId      String?       @unique
  quoteId         String?       @unique
  daysSequence    Int[]
  templateId      String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?

  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  template      Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("follow_up_rules")
}

enum FollowUpScope {
  DEFAULT
  CUSTOMER_GROUP
  CUSTOMER
  QUOTE
}

// ---------------------------------------------------------------------------
// M6 PowerOffice (IN-01–04, IN-20–23, KU-03, KU-08). Arbeidsregel 12: alt av
// faktisk PowerOffice-trafikk skjer kun fra workeren, aldri i en
// brukerforespørsel – admin-sidene legger kun jobber i køen eller leser
// cachede felt/SyncLog.
// ---------------------------------------------------------------------------

// IN-23: miljøvalg og nøkler settes i administrasjonen, ikke i kode/.env.
// Nøklene krypteres på samme måte som e-postkontopassord (src/lib/secrets.ts).
// Én rad («singleton») – ingen egen UI for å opprette flere tilkoblinger.
model PowerOfficeSettings {
  id                       String                 @id @default("singleton")
  environment              PowerOfficeEnvironment @default(DEMO)
  encryptedApplicationKey  String?
  encryptedClientKey       String?
  encryptedSubscriptionKey String?
  // IN-23: første gang PRODUCTION velges er synk kun lesende inntil
  // administrator eksplisitt slår på skriving.
  writeEnabled             Boolean                @default(false)
  updatedAt                DateTime               @updatedAt
  updatedById              String?

  @@map("poweroffice_settings")
}

enum PowerOfficeEnvironment {
  DEMO
  PRODUCTION
}

// IN-21: logg over synkroniseringer og tydelig varsel ved feil.
model SyncLog {
  id          String   @id @default(uuid())
  integration String
  direction   String // "in" | "out"
  entityType  String?
  entityId    String?
  status      String // "success" | "error"
  message     String?
  createdAt   DateTime @default(now())

  @@index([integration, createdAt])
  @@index([status])
  @@map("sync_logs")
}
